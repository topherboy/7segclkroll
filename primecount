
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
 content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<title>Rolling Prime Numbers</title>
<style>
* { box-sizing:border-box; }

body {
  margin:0;
  background:white;
  color:#16803c;
  font-family:-apple-system,BlinkMacSystemFont,
              "Helvetica Neue",Arial,sans-serif;
}

main {
  min-height:100vh;
  min-height:100dvh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  padding:20px;
  text-align:center;
}

#tap {
  background:transparent;
  color:#16803c;
  border:0;
  width:100%;
  cursor:pointer;
  touch-action:manipulation;
  -webkit-tap-highlight-color:transparent;
}

.window {
  width:100%;
  height:230px;
  overflow:hidden;
  position:relative;
}

.number {
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:clamp(75px,19vw,170px);
  font-weight:800;
  line-height:1;
  white-space:nowrap;
  font-variant-numeric:tabular-nums;
  transition:transform 750ms
    cubic-bezier(.22,1,.36,1);
  will-change:transform;
}

#fact {
  max-width:520px;
  min-height:85px;
  font-size:clamp(17px,4vw,22px);
  line-height:1.45;
  color:#345c41;
  margin:18px 0 6px;
}

#counter {
  color:#60846d;
  font-size:15px;
  margin:10px;
}

.hint {
  color:#82998a;
  font-size:14px;
  margin:10px;
}

#reset {
  background:#effaf2;
  color:#176735;
  border:1px solid #b8d8c1;
  border-radius:12px;
  padding:12px 24px;
  font-size:16px;
  margin-top:20px;
  cursor:pointer;
}

@media(prefers-reduced-motion:reduce) {
  .number { transition-duration:0ms; }
}
</style>
</head>
<body>
<main>
  <button id="tap" aria-label="Show next prime">
    <div class="window" id="window">
      <div class="number">2</div>
    </div>
  </button>

  <div id="fact">
    2 is the only even prime number.
  </div>

  <div id="counter">Prime #1</div>
  <div class="hint">Tap the number to roll upward</div>
  <button id="reset">↺ Start over</button>
</main>

<script>
"use strict";

let current = 2;
let index = 1;
let rolling = false;
let animationToken = 0;
let previousPrime = null;

const windowEl = document.getElementById("window");
const factEl = document.getElementById("fact");
const counterEl = document.getElementById("counter");

const specialFacts = {
  2: "2 is the only even prime number. All other primes are odd.",
  3: "3 is the smallest odd prime number.",
  5: "5 is the only prime number ending in 5.",
  7: "7 and 5 are twin primes, only 2 apart.",
  11: "11 is a palindrome prime. It reads the same backward!",
  13: "11 and 13 are twin primes.",
  17: "17 and 19 form a twin-prime pair.",
  19: "19 and 17 are twin primes.",
  23: "23 is the ninth prime number.",
  29: "29 and 31 are twin primes.",
  31: "31 is the eleventh prime number.",
  37: "37 and 31 are separated by a gap of 6.",
  41: "41 and 43 are twin primes.",
  43: "43 is the larger of the twin primes 41 and 43.",
  47: "47 is the fifteenth prime number."
};

function isPrime(n) {
  if(!Number.isSafeInteger(n) || n < 2)
    return false;

  if(n === 2) return true;
  if(n % 2 === 0) return false;

  for(let i = 3; i <= Math.sqrt(n); i += 2) {
    if(n % i === 0) return false;
  }
  return true;
}

function nextPrime(n) {
  let candidate = n + 1;
  while(Number.isSafeInteger(candidate)) {
    if(isPrime(candidate)) return candidate;
    candidate++;
  }
  return null;
}

function learningFact(n) {
  if(specialFacts[n]) return specialFacts[n];

  if(isPrime(n + 2)) {
    return n + " and " + (n + 2) +
      " are twin primes, just 2 apart.";
  }

  if(isPrime(n - 2)) {
    return (n - 2) + " and " + n +
      " are twin primes, just 2 apart.";
  }

  const digits = String(n);

  if(digits.length > 1 &&
     digits === [...digits].reverse().join("")) {
    return n + " is a palindrome prime. " +
      "It reads the same forward and backward.";
  }

  if(previousPrime !== null) {
    const gap = n - previousPrime;
    return "The gap from the previous prime, " +
      previousPrime + ", is " + gap +
      ". Prime gaps can vary!";
  }

  return n +
    " is prime because its only positive " +
    "divisors are 1 and " + n + ".";
}

function createNumber(value, offset) {
  const el = document.createElement("div");
  el.className = "number";
  el.textContent = value.toLocaleString("en-US");
  el.style.transform = "translateY(" + offset + "%)";
  return el;
}

function advance() {
  if(rolling) return;

  const next = nextPrime(current);
  if(next === null) return;

  rolling = true;
  const token = ++animationToken;

  previousPrime = current;
  current = next;
  index++;

  const outgoing = windowEl.firstElementChild;
  const incoming = createNumber(current, 110);

  windowEl.appendChild(incoming);

  factEl.textContent = learningFact(current);
  counterEl.textContent = "Prime #" + index;

  // Allow Safari to paint the new number below
  // before beginning the synchronized transition.
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      if(token !== animationToken) return;
      outgoing.style.transform = "translateY(-110%)";
      incoming.style.transform = "translateY(0%)";
    });
  });

  setTimeout(() => {
    if(token !== animationToken) return;
    windowEl.replaceChildren(incoming);
    rolling = false;
  }, 800);
}

function reset() {
  animationToken++;
  rolling = false;
  current = 2;
  index = 1;
  previousPrime = null;

  windowEl.replaceChildren(createNumber(2, 0));
  factEl.textContent = specialFacts[2];
  counterEl.textContent = "Prime #1";
}

document.getElementById("tap")
  .addEventListener("click",advance);

document.getElementById("reset")
  .addEventListener("click",reset);

reset();
</script>
</body>
</html>
